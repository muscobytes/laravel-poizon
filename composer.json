{
    "name": "muscobytes/laravel-poizon",
    "description": "Poizon Open Platform protocol and durable OAuth for Laravel 12",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0",
        "illuminate/console": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/encryption": "^12.0",
        "illuminate/http": "^12.0",
        "illuminate/support": "^12.0",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "ext-zip": "*",
        "laravel/pint": "^1.24",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Muscobytes\\Poizon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Muscobytes\\Poizon\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Muscobytes\\Poizon\\PoizonServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint"
    },
    "config": {
        "sort-packages": true
    },
    "keywords": [
        "laravel",
        "poizon",
        "sdk",
        "oauth"
    ],
    "homepage": "https://github.com/muscobytes/laravel-poizon",
    "support": {
        "issues": "https://github.com/muscobytes/laravel-poizon/issues",
        "source": "https://github.com/muscobytes/laravel-poizon"
    }
}
